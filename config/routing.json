  "chitchat_phrases": [
    "你好", "您好", "嗨", "hello", "hi", "谢谢", "感谢", "再见", "你是谁", "你能做什么"
  ],
  "follow_up_markers": [
    "那", "那么", "这个", "那个", "它", "刚才", "继续", "还有", "然后", "明天", "后天", "上午", "下午"
  ],
  "safety_rules": [
    {
      "id": "prompt_injection",
      "category": "prompt_injection",
      "decision": "block",
      "patterns": [
        "忽略(?:之前|以上|所有).*指令",
        "(?:输出|泄露|显示).*(?:系统提示词|开发者消息|system prompt)",
        "绕过.*(?:安全|审核|限制)"
      ]
    },
    {
      "id": "dangerous_illegal_request",
      "category": "illegal_harm",
      "decision": "block",
      "patterns": [
        "(?:如何|怎么|帮我).*(?:制造|制作).*(?:炸弹|爆炸物)",
        "(?:骗保|伪造事故).*(?:方法|教程|怎么)",
        "(?:偷车|盗车).*(?:方法|教程|怎么)"
      ]
    },
    {
      "id": "identity_number",
      "category": "sensitive_personal_data",
      "decision": "review",
      "patterns": ["(?<!\\d)\\d{17}[0-9Xx](?!\\d)"]
    },
    {
      "id": "phone_number",
      "category": "sensitive_personal_data",
      "decision": "review",
      "patterns": ["(?<!\\d)1[3-9]\\d{9}(?!\\d)"]
    }
  ]
}
