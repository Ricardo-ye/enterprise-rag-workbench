RAG_ENVIRONMENT=local
RAG_LOG_LEVEL=INFO
RAG_MODEL_PROVIDER=mock
RAG_MODEL_TIMEOUT_SECONDS=30
RAG_API_KEY=
RAG_TRUSTED_HOSTS=localhost,127.0.0.1,testserver
RAG_RATE_LIMIT_REQUESTS_PER_MINUTE=120

# Knowledge store and offline embedding index
RAG_DATABASE_PATH=data/enterprise_rag.db
RAG_DATABASE_BACKUP_DIRECTORY=backups
RAG_SQLITE_BUSY_TIMEOUT_MS=30000
RAG_SQLITE_SYNCHRONOUS=NORMAL
RAG_MAX_UPLOAD_BYTES=20971520
RAG_CHUNK_MAX_CHARS=1200
RAG_CHUNK_OVERLAP_CHARS=200
RAG_EMBEDDING_DIMENSIONS=384

# Safety and routing
RAG_ROUTING_CONFIG_PATH=config/routing.json
RAG_ROUTING_MIN_INTENT_CONFIDENCE=0.65
RAG_ROUTING_MIN_DOMAIN_CONFIDENCE=0.55
RAG_ROUTING_FALLBACK_SIMILARITY=0.42

# Task Flow and KBQA gates
RAG_KBQA_FIRST_GATE_THRESHOLD=0.90
RAG_KBQA_SECOND_GATE_THRESHOLD=0.90

# Five-way RAG retrieval
RAG_RETRIEVAL_TIMEOUT_MS=1500
RAG_RETRIEVAL_TOP_K_PER_ROUTE=10
RAG_RETRIEVAL_FUSED_TOP_K=20
RAG_RETRIEVAL_CONTEXT_TOP_K=5
RAG_RRF_K=60
RAG_CIRCUIT_FAILURE_THRESHOLD=3
RAG_CIRCUIT_RESET_SECONDS=30
RAG_RERANKER_PROVIDER=heuristic
RAG_CROSS_ENCODER_MODEL=BAAI/bge-reranker-v2-m3

# Set to searxng and provide a URL to enable the real-time web route.
RAG_WEB_SEARCH_PROVIDER=disabled
RAG_SEARXNG_BASE_URL=http://localhost:8080

# Evidence-grounded generation and final quality gates
RAG_GENERATION_SELF_SCORE_THRESHOLD=0.90
RAG_GENERATION_POST_AUDIT_THRESHOLD=0.90
RAG_GENERATION_MIN_GROUNDING_COVERAGE=0.15
RAG_GENERATION_MIN_EVIDENCE_SCORE=0.35
RAG_GENERATION_MAX_TOKENS=800
RAG_GENERATION_STORE_RECORDS=true

# Process-lifetime SLO targets
RAG_SLO_AVAILABILITY_TARGET=0.99
RAG_SLO_P95_LATENCY_MS=2000
RAG_SLO_ANSWER_SUCCESS_TARGET=0.90

# OpenAI-compatible provider
RAG_OPENAI_BASE_URL=https://api.openai.com/v1
RAG_OPENAI_API_KEY=
RAG_OPENAI_MODEL=gpt-4.1-mini

# Ollama provider
RAG_OLLAMA_BASE_URL=http://localhost:11434
RAG_OLLAMA_MODEL=qwen2.5:7b

